PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT Secrets
JWT_ACCESS_SECRET=kinlink_super_secret_access_token_key_change_me_in_prod
JWT_REFRESH_SECRET=kinlink_super_secret_refresh_token_key_change_me_in_prod
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Firebase Firestore Configuration (Database)
# Option A: Place serviceAccountKey.json in the backend/ directory
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Option B: Individual environment variables
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ImageKit Configuration (Media Storage & Optimization)
# Obtain these from your ImageKit.io Dashboard (Developer Options)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
